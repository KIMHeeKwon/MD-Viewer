{
  "name": "md-viewer",
  "productName": "MD Viewer",
  "version": "0.13.0",
  "description": "단독 실행 마크다운 뷰어 — GFM + KaTeX + Mermaid + Obsidian 확장",
  "author": "KIMHeeKwon <hkkim79@gmail.com>",
  "license": "MIT",
  "private": true,
  "main": "src/main.js",
  "scripts": {
    "bundle": "esbuild src/renderer/renderer.js --bundle --outdir=renderer-dist --entry-names=renderer --minify --loader:.woff2=file --loader:.woff=file --loader:.ttf=file && node -e \"require('fs').copyFileSync(require.resolve('pdfjs-dist/build/pdf.worker.min.mjs'), 'renderer-dist/pdf.worker.min.mjs')\"",
    "build": "npm run bundle",
    "test": "node --test test/edit-core.test.mjs",
    "start": "npm run bundle && electron .",
    "dist": "npm run bundle && electron-builder"
  },
  "build": {
    "appId": "kr.hkkim.mdviewer",
    "files": [
      "src/**/*",
      "renderer-dist/**/*"
    ],
    "fileAssociations": [
      {
        "ext": "md",
        "name": "Markdown Document",
        "role": "Viewer"
      },
      {
        "ext": "markdown",
        "name": "Markdown Document",
        "role": "Viewer"
      },
      {
        "ext": "mdown",
        "name": "Markdown Document",
        "role": "Viewer"
      }
    ],
    "publish": {
      "provider": "github",
      "releaseType": "release"
    },
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "build/icon.icns"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "build/icon.png",
      "category": "Office;Viewer;TextEditor",
      "synopsis": "단독 실행 마크다운 · PDF 뷰어",
      "desktop": {
        "entry": {
          "MimeType": "text/markdown;text/x-markdown;application/pdf"
        }
      }
    }
  },
  "dependencies": {
    "chokidar": "^4.0.3",
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.1",
    "highlight.js": "^11.11.1",
    "katex": "^0.18.1",
    "markdown-it": "^14.3.0",
    "markdown-it-footnote": "^4.0.0",
    "markdown-it-task-lists": "^2.1.1",
    "markdown-it-texmath": "^1.0.0",
    "mermaid": "^11.16.0",
    "pdfjs-dist": "^6.1.200"
  }
}
